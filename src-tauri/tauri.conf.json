{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "mySIPPhone",
  "version": "0.1.2",
  "identifier": "com.mysipphone.desktop",
  "build": {
    "beforeDevCommand": "cd frontend && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd frontend && npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "mySIPPhone",
        "transparent": true,
        "width": 320,
        "height": 600,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/lib/mysipphone/libpjsua.so.2": "../pjsip-dist/lib/libpjsua.so.2",
          "/usr/lib/mysipphone/libpjsip-ua.so.2": "../pjsip-dist/lib/libpjsip-ua.so.2",
          "/usr/lib/mysipphone/libpjsip-simple.so.2": "../pjsip-dist/lib/libpjsip-simple.so.2",
          "/usr/lib/mysipphone/libpjsip.so.2": "../pjsip-dist/lib/libpjsip.so.2",
          "/usr/lib/mysipphone/libpjmedia-audiodev.so.2": "../pjsip-dist/lib/libpjmedia-audiodev.so.2",
          "/usr/lib/mysipphone/libpjmedia-codec.so.2": "../pjsip-dist/lib/libpjmedia-codec.so.2",
          "/usr/lib/mysipphone/libpjmedia.so.2": "../pjsip-dist/lib/libpjmedia.so.2",
          "/usr/lib/mysipphone/libpjnath.so.2": "../pjsip-dist/lib/libpjnath.so.2",
          "/usr/lib/mysipphone/libpjlib-util.so.2": "../pjsip-dist/lib/libpjlib-util.so.2",
          "/usr/lib/mysipphone/libpj.so.2": "../pjsip-dist/lib/libpj.so.2",
          "/usr/lib/mysipphone/libsrtp.so.2": "../pjsip-dist/lib/libsrtp.so.2",
          "/usr/lib/mysipphone/libresample.so.2": "../pjsip-dist/lib/libresample.so.2",
          "/usr/lib/mysipphone/libspeex.so.2": "../pjsip-dist/lib/libspeex.so.2",
          "/usr/lib/mysipphone/libgsmcodec.so.2": "../pjsip-dist/lib/libgsmcodec.so.2",
          "/usr/lib/mysipphone/libilbccodec.so.2": "../pjsip-dist/lib/libilbccodec.so.2",
          "/usr/lib/mysipphone/libg7221codec.so.2": "../pjsip-dist/lib/libg7221codec.so.2",
          "/usr/lib/mysipphone/libpjmedia-videodev.so.2": "../pjsip-dist/lib/libpjmedia-videodev.so.2"
        }
      },
      "deb": {
        "desktopTemplate": "templates/main.desktop",
        "files": {
          "/usr/lib/mysipphone/libpjsua.so.2": "../pjsip-dist/lib/libpjsua.so.2",
          "/usr/lib/mysipphone/libpjsip-ua.so.2": "../pjsip-dist/lib/libpjsip-ua.so.2",
          "/usr/lib/mysipphone/libpjsip-simple.so.2": "../pjsip-dist/lib/libpjsip-simple.so.2",
          "/usr/lib/mysipphone/libpjsip.so.2": "../pjsip-dist/lib/libpjsip.so.2",
          "/usr/lib/mysipphone/libpjmedia-audiodev.so.2": "../pjsip-dist/lib/libpjmedia-audiodev.so.2",
          "/usr/lib/mysipphone/libpjmedia-codec.so.2": "../pjsip-dist/lib/libpjmedia-codec.so.2",
          "/usr/lib/mysipphone/libpjmedia.so.2": "../pjsip-dist/lib/libpjmedia.so.2",
          "/usr/lib/mysipphone/libpjnath.so.2": "../pjsip-dist/lib/libpjnath.so.2",
          "/usr/lib/mysipphone/libpjlib-util.so.2": "../pjsip-dist/lib/libpjlib-util.so.2",
          "/usr/lib/mysipphone/libpj.so.2": "../pjsip-dist/lib/libpj.so.2",
          "/usr/lib/mysipphone/libsrtp.so.2": "../pjsip-dist/lib/libsrtp.so.2",
          "/usr/lib/mysipphone/libresample.so.2": "../pjsip-dist/lib/libresample.so.2",
          "/usr/lib/mysipphone/libspeex.so.2": "../pjsip-dist/lib/libspeex.so.2",
          "/usr/lib/mysipphone/libgsmcodec.so.2": "../pjsip-dist/lib/libgsmcodec.so.2",
          "/usr/lib/mysipphone/libilbccodec.so.2": "../pjsip-dist/lib/libilbccodec.so.2",
          "/usr/lib/mysipphone/libg7221codec.so.2": "../pjsip-dist/lib/libg7221codec.so.2",
          "/usr/lib/mysipphone/libpjmedia-videodev.so.2": "../pjsip-dist/lib/libpjmedia-videodev.so.2"
        }
      }
    }
  }
}
